+  const box=node('div','algebraErrorComparison');field(box,'Bài làm học sinh',record.student,tasks);field(box,'Lời giải đúng',record.correct,tasks);field(box,'Giải thích',record.explanation,tasks);parent.append(box);
+ }
+ function proof(screen,state,answer,tasks){
+  const steps=liveSteps(screen),mode=state.answerMode;
+  const count=mode==='full'?steps.length:mode==='steps'?Math.min(steps.length,Math.max(0,Math.trunc(state.answerStep||0))):0;
+  const visible=liveAnswerText(screen,mode,state.answerStep||0);
